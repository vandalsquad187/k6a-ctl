#!/system/bin/sh
# k6a-ctl controller v1.4.9 — delegated thermal management
# states: DAILY | GAMING
# v1.4.9: (a) mode=auto — pidof + /proc/<pid>/cgroup top-app + Hysterese
#   (2 Bestaetigungs-Ticks rein, 10s ohne top-app raus -> DAILY); mode=gaming
#   bleibt als Dauer-Test-Art (enable=1). (b) Status-Parsen ohne forks
#   (while-read direkt aus der status-Node). (c) cfg_load nur bei geaenderter
#   settings.conf (stat-Signatur). (d) data.txt-Takt: gaming 2s, sonst 5s +
#   Force-Write bei State-Wechsel. (e) zero-fork-reads in _write_data.
# tick-sleep: daily=5s gaming=1s
# v1.4.2: silver_cap_gaming (policy0) + gpu_cap_gaming (kgsl) deckel, Kappe
# v1.4.3: thermal_protect wirksam (on=Deckel/mäß, off=Deckel pausiert); Gold-Cap-UI-Toggle
# v1.4.5: webui-watchdog (respawn, wenn webui-server-wrapper tot)

MODDIR="${1:-/data/adb/modules/k6a-ctl}"
CONFIG="$MODDIR/config/settings.conf"
LOG="$MODDIR/config/service.log"
DATA="$MODDIR/webroot/data.txt"
PIDF="$MODDIR/run/controller.pid"
GOV="/sys/kernel/k6a_gov"

export MODDIR LOG_FILE=$LOG
. "$MODDIR/bin/k6a-lib.sh"

STATE=""; TICK=0; IDLE=0; _PREV=0; _GAMING_APPLIED=0
_STE_PREV=""; _STE_N=0; _STE_TRIED=0
_GM_SET=""; _VP_SET=""
_FORCE_DATA=0; _CFG_SIG="__unset__"; _MODVER=""
_AUTO_PID=""; _AUTO_HIT=0; _AUTO_LAST=0; _HIST=""; _lsf_state=""
_STV=""; _SSTATE=""; _STEMP=""; _STHROT=""; _SPMAX=""; _SAGE=""; _SVSRC=""; _SVVAL=""
_SHASHV=""; _SHASHS=""; _SBW1=""; _SBW2=""; _SHIST=""
SILCAP_G="0"; GPUCAP_G="0"
_GOLD_CAP_APPLIED=""; _SIL_CAP_APPLIED=""; _GPU_CAP_APPLIED=""
_THP_APPLIED=""
    CFG_DEBUG=0
    CAP_G_RAW=""; CAP_D_RAW=""
    SILCAP_G_RAW="0"; GPUCAP_G_RAW="0"

# Gold-Cluster-Deckelung: 0 = frei; sonst nächstgelegene OPP ≤ Ziel (F14)
_norm_cap() { # $1=roh — snappt auf verfügbare OPP, 0 bleibt 0
    case "$1" in ''|*[!0-9]*) echo 0; return ;; esac
    [ "$1" -eq 0 ] 2>/dev/null && { echo 0; return; }
    _pick_freq "$GOLD_FREQS" "$1"
}

cfg_load() { # 1x settings.conf einlesen statt 10x (F11)
    MODE=""; THP=""; PKG=""; DELEGATED=""; PROFILE=""
    AUTO_BT=""; AUTO_HYST=""; BATT_T=""; BATT_GUARD=""; CFG_DEBUG=""
    CAP_G=""; CAP_D=""; CDT=""
    local _line _kk _vv
    if [ -f "$CONFIG" ]; then
        while IFS= read -r _line || [ -n "$_line" ]; do
            case "$_line" in \#*|"") continue ;; esac
            _kk=${_line%%=*}; _vv=${_line#*=}; _vv=${_vv%%#*}
            case "$_kk" in
                mode) MODE=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                thermal_protect) THP=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                game_pkg) PKG=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                delegated) DELEGATED=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                profile) PROFILE=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                auto_badazz_temp) AUTO_BT=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                auto_badazz_hyst) AUTO_HYST=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                battery_guard_temp) BATT_T=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                battery_guard) BATT_GUARD=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
                gold_cap_gaming) CAP_G=$(printf '%s' "$_vv" | tr -d '\r\n') ;;
                gold_cap_daily) CAP_D=$(printf '%s' "$_vv" | tr -d '\r\n') ;;
                silver_cap_gaming) SILCAP_G_RAW=$(printf '%s' "$_vv" | tr -d '\r\n') ;;
                gpu_cap_gaming) GPUCAP_G_RAW=$(printf '%s' "$_vv" | tr -d '\r\n') ;;
                cd_thresholds) CDT=$(printf '%s' "$_vv" | tr -d '\r\n') ;;
                debug) CFG_DEBUG=$(printf '%s' "$_vv" | tr -d ' \t\r\n') ;;
            esac
        done < "$CONFIG" 2>/dev/null
    fi
    [ "$MODE" = "gaming" ] || [ "$MODE" = "auto" ] || MODE="daily"
    [ "$THP" = "off" ] || THP="on"
    PKG=${PKG:-com.activision.callofduty.shooter}
    case "$PKG" in ""|*[!A-Za-z0-9._]*) PKG="com.activision.callofduty.shooter" ;; esac
    [ "$DELEGATED" = "0" ] || DELEGATED=1
    case "$PROFILE" in gaming|battery|badazz|badazz_safe|custom|off) ;; *) PROFILE="gaming" ;; esac
    case "$AUTO_BT" in ''|*[!0-9]*) AUTO_BT=85 ;; *) [ "$AUTO_BT" -lt 70 ] 2>/dev/null && AUTO_BT=70; [ "$AUTO_BT" -gt 95 ] 2>/dev/null && AUTO_BT=95 ;; esac
    case "$AUTO_HYST" in ''|*[!0-9]*) AUTO_HYST=5 ;; *) [ "$AUTO_HYST" -lt 3 ] 2>/dev/null && AUTO_HYST=3; [ "$AUTO_HYST" -gt 10 ] 2>/dev/null && AUTO_HYST=10 ;; esac
    case "$BATT_T" in ''|*[!0-9]*) BATT_T=45 ;; *) [ "$BATT_T" -lt 35 ] 2>/dev/null && BATT_T=35; [ "$BATT_T" -gt 60 ] 2>/dev/null && BATT_T=60 ;; esac
    [ "$BATT_GUARD" = "off" ] || BATT_GUARD="on"
    [ "$CFG_DEBUG" = "1" ] || CFG_DEBUG=0
    # Rohwert sichern — die Normalisierung gegen GOLD_FREQS läuft erst nach
    # _init_freq_tables im _startup, hier ist die Tabelle noch leer (F17)
    case "$CAP_G" in ''|*[!0-9]*) CAP_G=0 ;; esac
    case "$CAP_D" in ''|*[!0-9]*) CAP_D=0 ;; esac
    case "$SILCAP_G_RAW" in ''|*[!0-9]*) SILCAP_G_RAW=0 ;; esac
    case "$GPUCAP_G_RAW" in ''|*[!0-9]*) GPUCAP_G_RAW=0 ;; esac
    CAP_G_RAW=$CAP_G; CAP_D_RAW=$CAP_D
    # Erster Aufruf: GOLD_FREQS noch leer → 0; ab _init_freq_tables gültig (F17)
    CAP_G=$(_norm_cap "$CAP_G_RAW"); CAP_D=$(_norm_cap "$CAP_D_RAW")
    # Schwellwerte: genau 7 Zahlen, sonst ignorieren (Kernel-Defaults bleiben)
    case "$CDT" in
        ''|*[!0-9\ ]*) CDT="" ;;
        *) set -- $CDT; [ $# -eq 7 ] || CDT="" ;;
    esac
    return 0
}

# ── v1.4.9: status parsen ohne forks (while-read direkt aus der Node) ────────
_parse_status() {
    _STV=""; _SSTATE=""; _STEMP=""; _STHROT=""; _SPMAX=""; _SAGE=""; _SVSRC=""; _SVVAL=""
    _SHASHV=""; _SHASHS=""; _SBW1=""; _SBW2=""; _SHIST=""
    _sl=""; _kk=""; _vv=""
    [ -r "$GOV/status" ] || return 0
    while IFS= read -r _sl; do
        _kk=${_sl%%=*}
        case "$_sl" in *=*) _vv=${_sl#*=} ;; *) _vv="" ;; esac
        case "$_kk" in
            version) _STV=$_vv ;;
            state) _SSTATE=$_vv ;;
            temp) _STEMP=$_vv ;;
            throttle_events) _STHROT=$_vv ;;
            policy_max) _SPMAX=$_vv ;;
            state_age_ms) _SAGE=$_vv ;;
            temp_src) _SVSRC=$_vv ;;
            temp_valid) _SVVAL=$_vv ;;
            hash_verified) _SHASHV=$_vv ;;
            hash_state) _SHASHS=$_vv ;;
            bw_floor_gpubw) _SBW1=$_vv ;;
            bw_floor_llcc) _SBW2=$_vv ;;
            hist) _SHIST=$_vv ;;
        esac
    done < "$GOV/status"
    return 0
}

# ── v1.4.9: settings.conf nur neu laden, wenn stat-Signatur aendert ──────────
_cfg_maybe_load() {
    local sig
    sig=$(stat -c '%s %Y' "$CONFIG" 2>/dev/null) || sig="x"
    [ "$sig" = "$_CFG_SIG" ] && return 0
    _CFG_SIG="$sig"
    cfg_load
}

# ── v1.4.9: auto-erkennung (pidof + cgroup top-app, zero forks im cgroup-lesen)
_auto_eval() {
    local pid pidset topapp=0 _l1 _l2 _l3 _l4 _l5 _l6 _l7 _l8 _l9 _l10 _l11 _l12 _l13 _cgv
    pidset=$(pidof "$PKG" 2>/dev/null) || pidset=""
    pid=${pidset%%[ ]*}
    _AUTO_PID="${pid:-0}"
    if [ -z "$pid" ]; then
        _AUTO_HIT=0
        return 0
    fi
    _l1=""; _l2=""; _l3=""; _l4=""; _l5=""; _l6=""; _l7=""; _l8=""; _l9=""; _l10=""; _l11=""; _l12=""; _l13=""
    { read _l1; read _l2; read _l3; read _l4; read _l5; read _l6; read _l7; read _l8; read _l9; read _l10; read _l11; read _l12; read _l13; } < "/proc/$pid/cgroup" 2>/dev/null
    _cgv="$_l1 $_l2 $_l3 $_l4 $_l5 $_l6 $_l7 $_l8 $_l9 $_l10 $_l11 $_l12 $_l13"
    case "$_cgv" in
        *top-app*) topapp=1 ;;
    esac
    if [ "$topapp" = "1" ]; then
        _AUTO_HIT=$((_AUTO_HIT + 1))
        _AUTO_LAST=$(date +%s)
    else
        _AUTO_HIT=0
    fi
    return 0
}

# ── battery guard sync (kernel nodes battery_guard + battery_guard_temp) ─────
_sync_batt_guard() {
    local cur want en
    [ "$DELEGATED" = "1" ] || return 0
    gov_sysfs_exists || return 0
    if [ -f "$GOV/battery_guard_temp" ]; then
        cur=$(gov_read "battery_guard_temp" 2>/dev/null | tr -d ' \n\r\t')
        [ "$cur" = "$BATT_T" ] || gov_write "battery_guard_temp" "$BATT_T"
    fi
    [ -f "$GOV/battery_guard" ] || return 0
    want=0; [ "$BATT_GUARD" = "on" ] && want=1
    en=$(gov_read "battery_guard" 2>/dev/null | tr -d ' \n\r\t')
    [ "$en" = "$want" ] || gov_write "battery_guard" "$want"
}

# ── single thermal authority: k6a-ctl owns `legacy`, the kernel owns everything else
_LEGACY_SYNCED=""
_sync_legacy() {
    local want
    gov_sysfs_exists || return 0
    want=1; [ "$DELEGATED" = "1" ] || want=0
    [ "$_LEGACY_SYNCED" = "$want" ] && return 0
    gov_write "legacy" "$want" || return 0
    _LEGACY_SYNCED=$want
    log "legacy → $want (delegated=$DELEGATED)"
}

# ── game pid: stored/echoed by the kernel, never acted upon there ────────────
_GAME_PID=""
_set_game_pid() { # $1=pid oder leer
    local p
    p="${1:-0}"
    [ "$DELEGATED" = "1" ] || return 0
    gov_sysfs_exists || return 0
    [ "$_GAME_PID" = "$p" ] && return 0
    gov_write "game_pid" "$p" || return 0
    _GAME_PID=$p
}

# ── single instance guard ───────────────────────────────────────────────────
LOCKDIR="$MODDIR/run/ctrl.lock"
_startup() {
    mkdir -p "$MODDIR/run" "$MODDIR/config" "$MODDIR/webroot" 2>/dev/null
    if ! mkdir "$LOCKDIR" 2>/dev/null; then
        OLD=$(cat "$PIDF" 2>/dev/null)
        STALE=0
        if [ -z "$OLD" ]; then
            STALE=1
        elif [ -d "/proc/$OLD" ]; then
            c=$(tr '\0' ' ' < "/proc/$OLD/cmdline" 2>/dev/null)
            case "$c" in *k6a-ctl*) err "läuft bereits (pid $OLD)"; exit 1 ;; *) STALE=1 ;; esac
        else
            STALE=1
        fi
        if [ "$STALE" = "1" ]; then
            warn "stale-lock übernommen (vorheriger besitzer: ${OLD:-keiner})"
            rm -rf "$LOCKDIR"; rm -f "$PIDF"
            mkdir "$LOCKDIR" 2>/dev/null || { err "lock belegt"; exit 1; }
        fi
    fi
    trap 'rm -rf "$LOCKDIR"; rm -f "$PIDF"; exit' INT TERM
    echo $$ > "$PIDF"
    rm -f "$MODDIR"/run/*.tmp 2>/dev/null
    cfg_load; _cache_thermal_zones; _init_freq_tables
    _MODVER=$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null)
    # Caps gegen die frisch gelesene OPP-Tabelle normalisieren — cfg_load lief
    # vor _init_freq_tables, dort war GOLD_FREQS noch leer (F17)
    CAP_G=$(_norm_cap "$CAP_G_RAW"); CAP_D=$(_norm_cap "$CAP_D_RAW")
    case "$SILCAP_G_RAW" in ''|*[!0-9]*|0) SILCAP_G=0 ;; *) SILCAP_G=$SILCAP_G_RAW; [ "$SILVER_MAX" -gt 0 ] 2>/dev/null && [ "$SILCAP_G" -gt "$SILVER_MAX" ] && SILCAP_G=$SILVER_MAX ;; esac
    case "$GPUCAP_G_RAW" in ''|*[!0-9]*|0) GPUCAP_G=0 ;; *) GPUCAP_G=$GPUCAP_G_RAW; [ "$GPU_MAX" -gt 0 ] 2>/dev/null && [ "$GPUCAP_G" -gt "$GPU_MAX" ] && GPUCAP_G=$GPU_MAX ;; esac
    _ensure_gov
    # Schwellwerte neu anwenden — sie existieren nur im Sysfs und gehen bei
    # Reboot/Modul-Neustart sonst verloren (2× passiert, F16)
    _apply_cd_thresholds
    _fix_usb_autosuspend
    log "k6a-ctl v1.4.9 start (mode=$MODE thp=$THP delegated=$DELEGATED profile=$PROFILE batt_guard=$BATT_GUARD cap_g=${CAP_G:-0} cap_d=${CAP_D:-0} silver_cap=${SILCAP_G:-0} gpu_cap=${GPUCAP_G:-0})"
    if gov_sysfs_exists; then
        local gv
        gv=$(gov_read "status" 2>/dev/null | grep -oE "version=[^ ]+" | head -1 | cut -d= -f2)
        log "k6a_gov ${gv:-unbekannt} legacy=$(gov_read "legacy" 2>/dev/null | tr -d ' \n\r\t')"
        case "$gv" in
            1.[5-9].*) ;;
            "") warn "k6a_gov status ohne version — Build 341 (1.5.0) erwartet" ;;
            *) warn "k6a_gov $gv — ab Build 341 (1.5.0): CONFIG_K6A_GOV=m als Modul plus hash_state" ;;
        esac
    else
        warn "kein /sys/kernel/k6a_gov — reiner Legacy-Betrieb"
    fi
}

# ── USB dwc3 autosuspend - FIXED Badazz Build 68 (08.09.): keep auto (was LPM workaround) ───
_fix_usb_autosuspend() { return 0; }

# ── profile management ──────────────────────────────────────────────────────
_apply_profile() { # $1=profile-name
    local idx
    idx=$(profile_to_idx "$1")
    if [ "$DELEGATED" = "1" ] && gov_sysfs_exists; then
        gov_write "profile" "$idx"
        log "profile → $1 (idx=$idx)"
    fi
}

# ── auto badazz_safe switch ─────────────────────────────────────────────────
_auto_badazz_switch() { # $1=current_temp
    local t=$1 cur_profile
    [ "$PROFILE" = "gaming" ] || return 0
    cur_profile=$(gov_read "profile" 2>/dev/null | tr -d ' \n\r\t')
    if [ "$STATE" = "GAMING" ] && [ "$t" -ge "$AUTO_BT" ] 2>/dev/null; then
        case "$cur_profile" in
            1|gaming) _apply_profile "badazz_safe"; log "auto → badazz_safe @ ${t}°C (hyst ${AUTO_HYST})" ;;
        esac
    elif [ "$t" -lt "$(( AUTO_BT - AUTO_HYST ))" ] 2>/dev/null; then
        case "$cur_profile" in
            5|badazz_safe) _apply_profile "$PROFILE"; log "auto → $PROFILE @ ${t}°C (hyst ${AUTO_HYST})" ;;
        esac
    fi
}

# ── schedutil + userspace tuning ────────────────────────────────────────────
_apply_schedutil() { # $1=gaming|daily
    local ib=/sys/module/cpu_boost/parameters
    if [ "$1" = "gaming" ]; then
        w "$P0/schedutil/up_rate_limit_us" 500
        w "$P0/schedutil/down_rate_limit_us" 20000
        w "$P6/schedutil/up_rate_limit_us" 500
        w "$P6/schedutil/down_rate_limit_us" 20000
        w "$P0/schedutil/hispeed_load" 50
        w "$P0/schedutil/hispeed_freq" "$(gold_at_pct 90)"
        w "$P6/schedutil/hispeed_load" 50
        w "$P6/schedutil/hispeed_freq" "$GOLD_MAX"
        [ -d "$ib" ] && {
            w "$ib/input_boost_freq" "0:$(_pick_freq "$SILVER_FREQS" $(( SILVER_MAX * 70 / 100 ))) 1:$(_pick_freq "$SILVER_FREQS" $(( SILVER_MAX * 70 / 100 ))) 2:$(_pick_freq "$SILVER_FREQS" $(( SILVER_MAX * 70 / 100 ))) 3:$(_pick_freq "$SILVER_FREQS" $(( SILVER_MAX * 70 / 100 ))) 4:$(_pick_freq "$SILVER_FREQS" $(( SILVER_MAX * 70 / 100 ))) 5:$(_pick_freq "$SILVER_FREQS" $(( SILVER_MAX * 70 / 100 ))) 6:$(gold_at_pct 90) 7:$(gold_at_pct 90)"
            w "$ib/input_boost_ms" 40
        }
    else
        w "$P0/schedutil/up_rate_limit_us" 10000
        w "$P0/schedutil/down_rate_limit_us" 50000
        w "$P6/schedutil/up_rate_limit_us" 10000
        w "$P6/schedutil/down_rate_limit_us" 50000
        [ -d "$ib" ] && w "$ib/input_boost_ms" 0
    fi
}

_apply_gaming_userspace() { # billig: bei Entry + pro 5 Ticks (F13)
    _apply_schedutil gaming
    local pid
    pid=$(pidof "$PKG" 2>/dev/null | awk '{print $1}')
    _set_game_pid "$pid"
    if [ "$_GM_SET" != "1" ]; then
        setprop persist.sys.game_mode 1 2>/dev/null; _GM_SET=1
    fi
    if [ "$_VP_SET" != "1" ]; then
        setprop persist.sys.vulkan.perf_mode 1 2>/dev/null; _VP_SET=1
    fi
}

_tune_game_threads() { # billig: renice/oom nur — taskset entfallen (Android-cpuset setzt zurück)
    local pid
    pid=$(pidof "$PKG" 2>/dev/null | awk '{print $1}')
    [ -n "$pid" ] || return 0
    renice -n -10 "$pid" >/dev/null 2>&1
    echo -17 > "/proc/$pid/oom_adj" 2>/dev/null
}

# ── gold-cluster deckelung ────────────────────────────────────────────────────
# Kernbefund 2026-10: die Last ist bandbreiten-/wärmelimitiert, nicht cpu-limitiert.
# 1708800 Hz (−26 %) hob die Bildrate um ~17 % (49,8 → 58,2 fps), weil der
# Speicher kühler bleibt; darunter (1555200) wird man rechenlimitiert und die
# Bildrate bricht wieder ein. Tagesmodus deckelt tiefer, kostet im Alltag nichts.
_GOLD_CAP_APPLIED=""
_apply_gold_cap() { # $1=Hz (0 = aufheben)
    local want cur
    want="${1:-0}"
    case "$want" in ''|*[!0-9]*) want=0 ;; esac
    [ "$_GOLD_CAP_APPLIED" = "$want" ] && return 0
    if [ "$want" = "0" ]; then
        w "$P6/scaling_max_freq" "$GOLD_MAX"
    else
        w "$P6/scaling_max_freq" "$want"
    fi
    cur=$(r "$P6/scaling_max_freq")
    _GOLD_CAP_APPLIED=$want
    log "gold_cap → ${want:-off} (p6_max=$cur)"
}

# ── silver/GPU-deckel (v1.4.2) ──────────────────────────────────────────────
# 0 = kein Deckel (kgsl/policy0 bleibt auf Boot-Max). Rohwerte werden NICHT
# auf OPP gerastet — Kernel (cpufreq/devfreq) snapt selbst auf die Tabelle.
_apply_silver_cap() { # $1=Hz (0 = default)
    local want cur
    want="${1:-0}"
    case "$want" in ''|*[!0-9]*) want=0 ;; esac
    [ "$SILVER_MAX" -gt 0 ] 2>/dev/null && [ "$want" -gt "$SILVER_MAX" ] && want=$SILVER_MAX
    [ "$_SIL_CAP_APPLIED" = "$want" ] && return 0
    if [ "$want" = "0" ]; then
        w "$P0/scaling_max_freq" "$SILVER_MAX"
    else
        w "$P0/scaling_max_freq" "$want"
    fi
    cur=$(r "$P0/scaling_max_freq")
    _SIL_CAP_APPLIED=$want
    log "silver_cap → ${want:-default} (p0_max=$cur)"
}

_apply_gpu_cap() { # $1=Hz (0 = default)
    local want cur
    want="${1:-0}"
    case "$want" in ''|*[!0-9]*) want=0 ;; esac
    [ "$GPU_MAX" -gt 0 ] 2>/dev/null && [ "$want" -gt "$GPU_MAX" ] && want=$GPU_MAX
    [ "$_GPU_CAP_APPLIED" = "$want" ] && return 0
    gpu_limits "${want:-$GPU_MAX}"   # gpu_limits schreibt 0 → frei (GPU_MAX)
    cur=$(r "$GPU/devfreq/max_freq")
    _GPU_CAP_APPLIED=$want
    log "gpu_cap → ${want:-default} (kgsl_max=$cur)"
}

# ── schwellwerte aus settings.conf anwenden ──────────────────────────────────
# Kernel-Reihenfolge ist fix: l2t l3t l4t rec l2g l3g l4g. rec zuerst schreiben
# ergibt -EINVAL, still abgelehnt (F15). Idempotent: nur schreiben, wenn sysfs
# abweicht — verhindert Boot-Spam und ein unnötiges thresholds_user-Flag, wenn
# der Kernel-Default (build352 GAMING-Profil) bereits die selben Werte hält.
_apply_cd_thresholds() {
    [ -n "$CDT" ] || return 0
    gov_sysfs_exists || return 0
    local cur
    cur=$(r "$GOV/cd_thresholds" 2>/dev/null | tr '\n' ' ' | tr -s ' ' | sed 's/^ //;s/ $//')
    [ "$cur" = "$CDT" ] && return 0
    gov_write "profile" "$(profile_to_idx "$PROFILE")" 2>/dev/null
    gov_write "cd_thresholds" "$CDT" || return 0
    log "cd_thresholds ← $CDT"
}

# ── state transitions ───────────────────────────────────────────────────────
# thermal_protect (v1.4.3, jetzt wirksam): on = Deckel genau per settings.conf;
# off = Gaming-Deckel pausieren (gold/silver/gpu → Boot-Max). battery_guard,
# auto_badazz_switch und cd_thresholds bleiben UNABHÄNGIG davon — das sind
# die eigentlichen Kernel-Schutzschichten.
_apply_caps_gaming() {
    # v1.4.6: Guard muss auf Cap-Waerten reagieren (THP-only liess Gold-Cap-Toggle
    # unsichtbar werden — Kernel blieb auf Boot-Max, UI zeigte 2304)
    [ "$_THP_APPLIED" = "${THP}|${CAP_G:-0}|${SILCAP_G:-0}|${GPUCAP_G:-0}" ] && return 0
    _THP_APPLIED="${THP}|${CAP_G:-0}|${SILCAP_G:-0}|${GPUCAP_G:-0}"
    if [ "$THP" = "off" ]; then
        _apply_gold_cap 0; _apply_silver_cap 0; _apply_gpu_cap 0
        log "thermal_protect=off → Gaming-Deckel pausiert (gold/silver/gpu = Boot-Max)"
    else
        _apply_gold_cap "$CAP_G"; _apply_silver_cap "$SILCAP_G"; _apply_gpu_cap "$GPUCAP_G"
        log "thermal_protect=on → Deckel aktiv (gold=${CAP_G:-0} silver=${SILCAP_G:-0} gpu=${GPUCAP_G:-0})"
    fi
}

_enter_daily() {
    STATE="DAILY"; _GAMING_APPLIED=0; IDLE=0; _FORCE_DATA=1
    _set_game_pid ""
    _apply_gold_cap "$CAP_D"
    _apply_silver_cap 0
    _apply_gpu_cap 0
    _apply_schedutil daily
    [ "$_GM_SET" != "0" ] && { setprop persist.sys.game_mode 0 2>/dev/null; _GM_SET=0; }
    if [ "$DELEGATED" = "1" ] && gov_sysfs_exists; then
        gov_write "enable" 0
        log "-> DAILY (delegated, gov off, gold_cap=${CAP_D:-off}, silver_cap=default, gpu_cap=default)"
    else
        log "-> DAILY (legacy, gold_cap=${CAP_D:-off}, silver_cap=default, gpu_cap=default)"
    fi
}

_enter_gaming() {
    STATE="GAMING"; IDLE=0; _GAMING_APPLIED=0; _FORCE_DATA=1
    _apply_caps_gaming
    if [ "$DELEGATED" = "1" ] && gov_sysfs_exists; then
        _apply_cd_thresholds
        gov_write "enable" 1
        _apply_profile "$PROFILE"
        _sync_batt_guard
        log "-> GAMING (delegated, profile=$PROFILE, gold_cap=${CAP_G:-off}, silver_cap=${SILCAP_G:-off}, gpu_cap=${GPUCAP_G:-off})"
    else
        cpu_apply "$SILVER_MAX" "$GOLD_MAX"
        gpu_limits "$GPU_MAX"
        log "-> GAMING (legacy, gold_cap=${CAP_G:-off}, silver_cap=default, gpu_cap=default)"
    fi
}

# ── write data for webui (v1.4.9: zero-fork-node-reads, Takt vom Aufrufer) ──
_write_data() {
    local t=$1 _now cs cg gm gn bpc btp btpc gv gs gt gte gpf ghv ghs gpc gbw gbl ghe gpm gas gts gtv gbg gbt gpid
    _now=$(date +%s)

    gn=""; read -r gn < "$P0/scaling_cur_freq" 2>/dev/null || gn=0; cs=$(( ${gn:-0} / 1000 ))
    gn=""; read -r gn < "$P6/scaling_cur_freq" 2>/dev/null || gn=0; cg=$(( ${gn:-0} / 1000 ))
    gn=""; read -r gn < "$GPU/devfreq/cur_freq" 2>/dev/null || gn=0; gm=$(( ${gn:-0} / 1000000 ))
    gn=""; read -r bpc < /sys/class/power_supply/battery/capacity 2>/dev/null
    gn=""; read -r btp < /sys/class/power_supply/battery/temp 2>/dev/null
    btpc="$(( ${btp:-0} / 10 )).$(( ${btp:-0} % 10 ))"

    gv=""; gs=""; gt=""; gte=""; gpf=""; ghv=""; ghs=""; gpc=""
    gbw=""; gbl=""; ghe=""; gpm=""; gas=""; gts=""; gtv=""; gbg=""
    gbt=""; gpid=""
    if [ "$DELEGATED" = "1" ] && [ -d "$GOV" ]; then
        gv=$_STV; gs=$_SSTATE; gt=$_STEMP; gte=$_STHROT
        ghv=$_SHASHV; ghs=$_SHASHS
        gpm=$_SPMAX; gas=$_SAGE; gts=$_SVSRC; gtv=$_SVVAL
        case "$_SBW1" in "") gbw="" ;; *) gbw="gpubw $_SBW1" ;; esac
        case "$_SBW2" in "") gbl="" ;; *) gbl="llcc $_SBW2" ;; esac
        [ -r "$GOV/profile" ]            && { gn=""; read -r gpf  < "$GOV/profile" 2>/dev/null; }
        [ -r "$GOV/gpu_caps" ]           && { gn=""; read -r gpc  < "$GOV/gpu_caps" 2>/dev/null; }
        [ -r "$GOV/battery_guard_temp" ] && { gn=""; read -r gbt  < "$GOV/battery_guard_temp" 2>/dev/null; }
        [ -r "$GOV/battery_guard" ]      && { gn=""; read -r gbg  < "$GOV/battery_guard" 2>/dev/null; }
        [ -r "$GOV/game_pid" ]           && { gn=""; read -r gpid < "$GOV/game_pid" 2>/dev/null; }
        if [ "$_HIST" = "" ] && [ -n "$_SHIST" ]; then
            _HIST=$_SHIST
        elif [ -n "$_HIST" ] && [ -n "$_SSTATE" ] && [ "$_SSTATE" != "$_lsf_state" ]; then
            _HIST="$_HIST,$_now:$t:$_lsf_state>$_SSTATE"
        fi
        if [ -n "$_HIST" ]; then
            _hn=1; _h2="$_HIST"
            while [ "${_h2#*,}" != "$_h2" ]; do _h2=${_h2#*,}; _hn=$((_hn + 1)); done
            while [ "$_hn" -gt 15 ]; do _HIST=${_HIST#*,}; _hn=$((_hn - 1)); done
        fi
        _lsf_state=$_SSTATE
    fi

    cat > "${DATA}.tmp" << EOF
state=$STATE
mode=$MODE
thermal_protect=$THP
gold_cap=$CAP_G
temp=$t
cpu_sil_mhz=$cs
cpu_gold_mhz=$cg
gpu_mhz=$gm
delegated=$DELEGATED
tick=$TICK
bat=${bpc}%
bat_temp=${btpc}
ts=$_now
gov_version=$gv
gov_state=$gs
gov_temp=$gt
gov_throttle=$gte
gov_profile=$gpf
gov_hash=$ghv
gov_hash_state=$ghs
gov_gpu_caps=$gpc
gov_bw_gpubw=$gbw
gov_bw_llcc=$gbl
modver=$_MODVER
gov_batt_temp=$gbt
gov_policy_max=$gpm
gov_state_age=$gas
gov_temp_src=$gts
gov_temp_valid=$gtv
gov_batt_guard=$gbg
gov_game_pid=$gpid
gov_hist=${_HIST}
EOF
    mv "${DATA}.tmp" "$DATA"
}

# ── P4 stale-watchdog: Supervisor-Thread-Wedge erkennen ─────────────────────
# Liveness-Signal: state_age_ms waechst bei jedem Governor-Tick. 5 Ticks
# hintereinander identisches (state_age_ms | temp)-Tupel + gleicher state
# bei delegiert-laufendem Governor = Verdacht Thread haengt.
# Reaction (Reviewer-Vorschlag): enable=0 -> einmal rmmod+insmod+Reapply ->
# enable=1. Misserfolg: enable bleibt 0, Heartbeat-Log alle 60 Ticks.
# NUR GAMING/delegiert — DAILY/OFF-Parken ist legitimes Einfrieren.
_gov_stale_action() { # $1=grund
    if [ "$_STE_TRIED" = "1" ]; then
        err "GOV weiter wedged ($1) — enable bleibt 0 ${_STE_MSG:-}" && return 0
    fi
    _STE_TRIED=1
    err "GOV WEDGED (5 Ticks ohne Fortschritt, $1) — Recovery: enable=0, rmmod+insmod"
    gov_write "enable" 0
    sleep 1
    /system/bin/rmmod k6a_gov 2>/dev/null
    sleep 1
    if [ -f "$MODDIR/k6a_gov.ko" ]; then
        /system/bin/insmod "$MODDIR/k6a_gov.ko" 2>/dev/null
    fi
    sleep 1
    if gov_sysfs_exists; then
        _apply_cd_thresholds
        _apply_profile "$PROFILE"
        _sync_batt_guard
        gov_write "enable" 1
        _STE_N=0; _STE_PREV=""
        _STE_MSG="— Recovery gelungen (state_age beweist im naechsten Tick)"
        log "GOV Recovery: k6a_gov.ko neu geladen, enable=1, Profile/Thresholds re-applied"
    else
        _STE_MSG="(Recovery fehlgeschlagen $(_STE_DATE)) — Governor aus, k6a-Caps laufen im cpufreq weiter"
        err "GOV Recovery fehlgeschlagen — Governor aus gelassen (60-Tick-Heartbeat)"
    fi
}
_STE_DATE() { date '+%H:%M:%S'; }
_gov_stale_check() {
    [ "$DELEGATED" = "1" ] || { _STE_N=0; return 0; }
    [ "$STATE" = "GAMING" ] || { _STE_N=0; return 0; }
    [ -d "$GOV" ] || { _STE_N=0; return 0; }
    if [ -z "$_SSTATE" ]; then
        _STE_N=$((_STE_N + 1))
        if [ "$_STE_N" -ge 5 ] && [ $(( (_STE_N - 5) % 60 )) -eq 0 ] 2>/dev/null; then
            _gov_stale_action "status leer bei vorhandenem gov-Dir"
        fi
        return 0
    fi
    local cur st
    st="state=$_SSTATE"
    case "$_STEMP" in "") _STE_N=0; _STE_PREV=""; return 0 ;; esac
    case "$_SAGE"  in "") _STE_N=0; _STE_PREV=""; return 0 ;; esac
    cur="$_STEMP|$_SAGE"
    if [ "$cur" = "$_STE_PREV" ]; then
        _STE_N=$((_STE_N + 1))
    else
        _STE_N=0; _STE_PREV="$cur"; _STE_TRIED=0
    fi
    if [ "$_STE_N" -ge 5 ] && [ $(( (_STE_N - 5) % 60 )) -eq 0 ] 2>/dev/null; then
        _gov_stale_action "state Tuple eingefroren ($st, $cur)"
    fi
    return 0
}

# ── main ────────────────────────────────────────────────────────────────────
trap 'rm -f "$PIDF"; exit 143' INT TERM
_startup

log "main loop"
while true; do
    OLD=$(cat "$PIDF" 2>/dev/null)
    if [ -n "$OLD" ] && [ "$OLD" != "$$" ] && [ -d "/proc/$OLD" ]; then exit 0; fi
    echo $$ > "$PIDF"

    _cfg_maybe_load
    _ensure_gov
    _sync_legacy
    TEMP_NOW=$(read_temp)
    _parse_status
    _gov_stale_check

    if [ "$MODE" = "gaming" ]; then
        [ "$STATE" != "GAMING" ] && _enter_gaming
    elif [ "$MODE" = "auto" ]; then
        _auto_eval
        if [ "$STATE" = "GAMING" ]; then
            _nowa=$(date +%s)
            [ $(( _nowa - _AUTO_LAST )) -gt 10 ] && _enter_daily
        elif [ "$_AUTO_HIT" -ge 2 ]; then
            _enter_gaming
        elif [ "$STATE" != "DAILY" ]; then
            _enter_daily
        fi
    else
        [ "$STATE" != "DAILY" ] && _enter_daily
    fi

    if [ "$STATE" = "GAMING" ]; then
        _apply_caps_gaming
        [ "$_GAMING_APPLIED" = "0" ] && { _apply_gaming_userspace; _tune_game_threads; _GAMING_APPLIED=1; }
        [ $(( TICK % 5 )) -eq 0 ] && _apply_gaming_userspace
        [ $(( TICK % 60 )) -eq 0 ] && _tune_game_threads
        [ "$DELEGATED" = "1" ] && [ -n "$TEMP_NOW" ] && _auto_badazz_switch "$TEMP_NOW"
        [ "$MODE" = "auto" ] && _set_game_pid "${_AUTO_PID:-0}"
        SLEEP=1
    else
        SLEEP=5
    fi

    # data.txt: 2s-Takt im Gaming (TICK%2), sonst jeder Tick; force beim Wechsel
    _okdata=0
    [ "$STATE" = "GAMING" ] && [ $(( TICK % 2 )) -ne 0 ] || _okdata=1
    [ "$_FORCE_DATA" = "1" ] && { _okdata=1; _FORCE_DATA=0; }
    [ "$_okdata" = "1" ] && _write_data "$TEMP_NOW"

    # webui-watchdog (v1.4.5): alle 30 ticks — wrapper tot? → respawn
    [ $(( TICK % 30 )) -eq 0 ] && {
        _WP=$(cat "$MODDIR/run/webui.pid" 2>/dev/null)
        if ! { [ -n "$_WP" ] && [ -d "/proc/$_WP" ] && tr '\0' ' ' < "/proc/$_WP/cmdline" 2>/dev/null | grep -q webui-server; }; then
            rm -f "$MODDIR/run/webui.pid"
            setsid sh "$MODDIR/bin/webui-server.sh" >/dev/null 2>&1 </dev/null &
            log "webui respawn (wrapper tot, TICK=$TICK)"
        fi
    }
    TICK=$(( TICK + 1 ))
    [ $(( TICK % 60 )) -eq 0 ] && { _sync_batt_guard; log "hb tick=$TICK state=$STATE temp=${TEMP_NOW:--} delegated=$DELEGATED"; }
    sleep $SLEEP
done
